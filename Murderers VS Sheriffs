getgenv().SCRIPT_KEY = "KEYLESS"

local function cargarRemoto(url, etiqueta, maxWait)
	local inicio = os.clock()
	local ultimoError = nil

	while (os.clock() - inicio) < maxWait do
		local ok, err = pcall(function()
			local source = game:HttpGet(url)
			assert(type(source) == "string" and #source > 0, "Respuesta vacia")

			local recortado = source:match("^%s*(.-)%s*$")
			assert(not recortado:lower():match("^<!doctype html") and not recortado:lower():match("^<html"), "Respuesta HTML en lugar de Lua")

			local fn, syntaxErr = loadstring(source)
			assert(fn, "Error al compilar: " .. tostring(syntaxErr))
			return fn()
		end)

		if ok then
			return true
		end

		ultimoError = err
		warn(string.format("[%s] intento fallido -> %s", etiqueta, tostring(err)))

		local restante = maxWait - (os.clock() - inicio)
		if restante <= 0 then
			break
		end
		task.wait(math.min(1, restante))
	end

	warn(string.format("[%s] agoto el tiempo de espera (%ss). Ultimo error: %s", etiqueta, tostring(maxWait), tostring(ultimoError)))
	return false
end

